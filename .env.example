# Copy เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env ตัวจริงเด็ดขาด

# LLM provider
ANTHROPIC_API_KEY=

# Knowledge Studio (studio ตัวที่ 2) — endpoint สำหรับเรียก semantic search
KNOWLEDGE_STUDIO_URL=http://localhost:8001

# Auth — Identity Contract v1 (cloudforge-auth-core)
# Studio ไม่เก็บ secret key และไม่ออก token เองอีกต่อไป
# ค่าเหล่านี้ต้องตรงกับที่ Identity Service ออก JWT
AUTH_JWT_ISSUER=https://identity.cloudforge.internal
AUTH_JWT_AUDIENCE=cloudforge-platform
AUTH_JWKS_URL=https://identity.cloudforge.internal/.well-known/jwks.json
